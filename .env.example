# ==============================================================================
# Environment Configuration Template (.env.example)
# Copy to `.env.local` for local development. Never commit `.env.local` to git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT-SAFE / PUBLIC SUPABASE CONFIGURATION (Exposed via Vite)
# ------------------------------------------------------------------------------
# These values are public by design and embedded in the static JavaScript bundle.
# They are protected by Supabase Row Level Security (RLS) policies.
# Find these in Supabase Dashboard -> Project Settings -> API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Optional: Enable verbose Supabase debug logging in development console
# VITE_SUPABASE_DEBUG=false

# ------------------------------------------------------------------------------
# 2. PRIVATE SERVER / PIPELINE SECRETS (NEVER EXPOSE TO VITE OR BROWSER)
# ------------------------------------------------------------------------------
# Configure these ONLY in Vercel Project Settings (Environment Variables)
# and GitHub Repository Secrets (Settings -> Secrets and variables -> Actions).
#
# CRON_SECRET:
#   Shared secret string used by Vercel Cron and GitHub Actions to authenticate
#   keepalive queries to /api/keepalive.
# CRON_SECRET=your-random-32-byte-hex-or-uuid
#
# IMPORTANT SECURITY REMINDER:
# - NEVER set SUPABASE_SERVICE_ROLE_KEY in .env or with a VITE_ prefix!
# - Service role keys bypass all RLS policies and must NEVER enter client code.